package com.kevel.apso.caching

import scala.concurrent.Future

/**
  * Provides extension methods `.cachedSync()` and `.cachedAsync()` for `FunctionN` types.
  */
trait CachedFunctionsExtras {
  final implicit class Fn0SyncCachingExtras[V](fn: Function0[V])(implicit ev: SyncEvidence[V]) {
    /**
     * Caches the result of this computation.
     * @param conf the underlying cache settings.
     * @return a cached function.
     */
    final def cachedSync(conf: config.Cache): SyncMemoizeFn0[V] = {
      MemoizeFn.sync(fn, conf)
    }
  }
  [#
  final implicit class Fn1SyncCachingExtras[[#I0#], V](fn: Function1[[#I0#], V])(implicit ev: SyncEvidence[V]) {
    /**
     * Caches the result of this computation.
     * @param conf the underlying cache settings.
     * @return a cached function.
     */
    final def cachedSync(conf: config.Cache): SyncMemoizeFn1[[#I0#], V] = {
      MemoizeFn.sync(fn, conf)
    }
  }#
  ]

  final implicit class Fn0AsyncCachingFExtras[V](fn: Function0[Future[V]]) {
    /**
     * Caches the result of this asynchronous computation. Failing futures will eventually be evicted automatically.
     * @param conf the underlying cache settings.
     * @param defaultValue a default value to return if a completed value is not in cache. If not provided, the on-going future will be returned.
     * @return a cached function.
     */
    final def cachedAsync(conf: config.Cache, defaultValue: => Option[V] = None): AsyncMemoizeFn0[V] = {
      MemoizeFn.async(fn, conf, defaultValue)
    }

    /**
     * Caches this asynchronous computation and returns its completed value, using `defaultValue` if no value is immediately available.
     * @param conf the underlying cache settings.
     * @param defaultValue a default value to return if a completed value is not in cache.
     * @return a cached function.
     */
    final def cachedSync(conf: config.Cache, defaultValue: => V): SyncMemoizeFutureFn0[V] = {
      MemoizeFn.syncAsync(fn, conf, defaultValue)
    }
  }
  [#
  final implicit class Fn1AsyncCachingExtras[[#I0#], V](fn: Function1[[#I0#], Future[V]]) {
    /**
     * Caches the result of this asynchronous computation. Failing futures will eventually be evicted automatically.
     * @param conf the underlying cache settings.
     * @param defaultValue a default value to return if a completed value is not in cache. If not provided, the on-going future will be returned.
     * @return a cached function.
     */
    final def cachedAsync(conf: config.Cache, defaultValue: ([#I0#]) => Option[V] = ([#i0: I0#]) => None): AsyncMemoizeFn1[[#I0#], V] = {
      MemoizeFn.async(fn, conf, defaultValue)
    }

    /**
     * Caches this asynchronous computation and returns its completed value, using `defaultValue` while no value is immediately available.
     * @param conf the underlying cache settings.
     * @param defaultValue a default value to return if a completed value is not in cache.
     * @return a cached function.
     */
    final def cachedSync(conf: config.Cache, defaultValue: ([#I0#]) => V): SyncMemoizeFutureFn1[[#I0#], V] = {
      MemoizeFn.syncAsync(fn, conf, defaultValue)
    }
  }#
  ]
}
